{
  "multipart": [
    {
      "when": {
        "has_fruit": "false"
      },
      "apply": {
        "model": "awakening_system:block/cuihua_leaves"
      }
    },
    {
      "when": {
        "has_fruit": "true"
      },
      "apply": {
        "model": "awakening_system:block/cuihua_leaves_fruited"
      }
    }
  ]
}